# ────────────────────────────────────────────────────────────────────
# Lead form — server-side env vars.
# Copy this to `.env.local` and fill in real values for local dev.
# In production (Vercel), set these in Project Settings → Environment Variables.
# ────────────────────────────────────────────────────────────────────

# REQUIRED — Resend API key. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# REQUIRED for The River Report. A separate Resend sending key, restricted to
# news.anthonystolp.com, used for every newsletter email (the signup confirm,
# the welcome, and each issue). RESEND_API_KEY above only sends from the root
# domain, so it is never used for these. Unset: no newsletter email is sent,
# signups are still saved, and a warning naming this variable is logged.
NEWSLETTER_RESEND_API_KEY=

# Optional — sender address (must be on a verified Resend domain).
# Defaults to hello@anthonystolp.com if unset.
LEAD_FROM_EMAIL=hello@anthonystolp.com

# Optional — where lead notifications are delivered.
# Defaults to anthony@exsellexperts.com if unset.
LEAD_TO_EMAIL=anthony@exsellexperts.com

# Optional — n8n webhook URL. Every completed lead is POSTed here
# for downstream automations (Slack alerts, drip nurture, CRM sync,
# AI follow-up generation). Failures are logged but do not block
# the user submission. Replaces the prior Lofty integration.
N8N_WEBHOOK_URL=

# Optional — Lofty Open API key (Lofty → Settings → Integrations → API).
# When set, open-house sign-ins (source: "open-house") are created as new
# leads in Lofty via POST /v1.0/leads. Best-effort: failures are logged and
# never block the sign-in. Leave unset to skip the Lofty push.
LOFTY_API_KEY=

# ────────────────────────────────────────────────────────────────────
# Admin /admin/leads inbox auth — single-user password gate.
# ────────────────────────────────────────────────────────────────────

# REQUIRED — strong password for /admin login. Compared with timing-safe equality.
ADMIN_PASSWORD=

# REQUIRED — secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
ADMIN_COOKIE_SECRET=

# ────────────────────────────────────────────────────────────────────
# Multi-tenant seam.
# ────────────────────────────────────────────────────────────────────

# REQUIRED — UUID stamped on every lead as agent_id.
# When multi-tenancy ships, this becomes per-user; today it's hardcoded.
DEFAULT_AGENT_ID=

# ────────────────────────────────────────────────────────────────────
# Supabase — lead funnel database.
# Create a project at https://supabase.com, then grab these from
# Project Settings → API. Service role key bypasses RLS — keep server-only.
# ────────────────────────────────────────────────────────────────────

# REQUIRED for funnel persistence — project URL (e.g. https://xxxx.supabase.co).
SUPABASE_URL=

# REQUIRED for funnel persistence — service_role secret key. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# ────────────────────────────────────────────────────────────────────
# Mapbox — address autocomplete + map previews on /home-value funnel.
# Generate a public token at https://account.mapbox.com/access-tokens/.
# Public tokens are safe in client code; scope to anthonystolp.com domain.
# ────────────────────────────────────────────────────────────────────

# REQUIRED for home-value funnel — Mapbox public access token (pk.xxxx).
NEXT_PUBLIC_MAPBOX_TOKEN=

# ────────────────────────────────────────────────────────────────────
# Measurement & ads — all optional, all env-gated (unset → tag not rendered).
# GA4 + Google Ads share one gtag.js load (src/components/Pixels.tsx); funnel
# events from src/lib/track.ts flow to whichever IDs are set.
# ────────────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID ("G-XXXXXXXXXX"). Create a property at
# https://analytics.google.com → Admin → Data Streams → Web. This is the
# "see where people go" dashboard. Enable Enhanced Measurement for SPA pageviews.
NEXT_PUBLIC_GA4_ID=

# Google Search Console verification token. At https://search.google.com/search-console
# add the property, pick "HTML tag" method, copy the content="..." value here.
# This is the SEO dashboard: queries you rank for, clicks, impressions, indexing.
GOOGLE_SITE_VERIFICATION=

# Google Ads conversion ID ("AW-XXXXXXXXX"). Only needed once you run paid ads.
NEXT_PUBLIC_GADS_ID=

# Meta (Facebook) Pixel ID. Only needed for Meta ads.
NEXT_PUBLIC_META_PIXEL_ID=

# Ahrefs Web Analytics site key. From the Ahrefs Web Analytics install guide
# (the data-key value). Public site key, not a secret. Lightweight, cookieless
# pageview/traffic analytics alongside GA4.
NEXT_PUBLIC_AHREFS_KEY=
